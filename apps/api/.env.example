# Plantilla para apps/api - ver .env.example en la raíz del proyecto
DATABASE_URL="sqlserver://localhost:1433;database=inbestiga_db;user=sa;password=YourStrongPassword2026!;encrypt=true;trustServerCertificate=true;"
JWT_SECRET="inbestiga-super-secret-jwt-key-change-this-for-production"
JWT_EXPIRES_IN="7d"
AI_PROVIDER="GROQ"
GROQ_API_KEY="gsk_your_groq_api_key_here"

# WhatsApp - Evolution API v2
EVO_URL="http://localhost:8080"
EVO_KEY="YOUR_EVOLUTION_API_KEY"
EVO_INSTANCE="inbestiga"
# URL desde la que Evolution (Docker) alcanza al agente NestJS en el host
WHATSAPP_WEBHOOK_URL="http://host.docker.internal:4000/api/v1/whatsapp/webhook"

PAYMENT_PROVIDER="CULQI"
CULQI_PUBLIC_KEY="pk_test_your_culqi_public_key"
CULQI_SECRET_KEY="sk_test_your_culqi_secret_key"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# OpenAI (STT gpt-4o-mini-transcribe / LLM gpt-4o-mini / TTS gpt-4o-mini-tts)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_AGENT_ENABLED=true
