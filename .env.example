# =============================================================================
# INBESTIGA.TESIS - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a '.env' y completa con tus credenciales y configuración
# =============================================================================

# 1. Entorno y Puertos del Monorepo
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# 2. Base de Datos Microsoft SQL Server (Transaccional OLTP inbestiga_db)
# Formato Prisma: sqlserver://HOST:PORT;database=DB_NAME;user=USER;password=PASS;encrypt=true;trustServerCertificate=true;
DATABASE_URL="sqlserver://localhost:1433;database=inbestiga_db;user=sa;password=YourStrongPassword2026!;encrypt=true;trustServerCertificate=true;"

# 3. Autenticación y Seguridad (JWT)
JWT_SECRET="inbestiga-super-secret-jwt-key-change-this-for-production"
JWT_EXPIRES_IN="7d"

# 4. Proveedor de Inteligencia Artificial (AIProvider)
# Opciones disponibles: GROQ, GEMINI, OPENROUTER, GROK
AI_PROVIDER="GROQ"

# 4.1. Google Gemini
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# 4.2. Groq Cloud (Inferencia Ultra-Rápida LPU)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# 4.3. OpenRouter (Modelos de Código Abierto)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# 4.4. xAI Grok (Opcional)
GROK_API_KEY="your_grok_api_key_here"
GROK_BASE_URL="https://api.x.ai/v1"
GROK_MODEL="grok-2-mini"

# 5. Integración WhatsApp (OpenWA Bot / Baileys)
OPENWA_BASE_URL="http://localhost:2785"
OPENWA_API_KEY="your_openwa_api_secret_key"
OPENWA_SESSION_NAME="bot-inbestiga"
OPENWA_WEBHOOK_URL="http://localhost:4000/api/v1/whatsapp/webhook"

# 6. Pasarela de Pagos (PaymentProvider)
# Opciones disponibles: CULQI, STRIPE
PAYMENT_PROVIDER="CULQI"

# 6.1. Culqi (Yape Directo y Tarjetas)
CULQI_PUBLIC_KEY="pk_test_your_culqi_public_key"
CULQI_SECRET_KEY="sk_test_your_culqi_secret_key"
CULQI_WEBHOOK_SECRET="whsec_your_culqi_webhook_secret"

# 6.2. Stripe (Alternativa internacional)
PAYMENT_SECRET_KEY="sk_test_your_stripe_secret_key"
PAYMENT_PUBLIC_KEY="pk_test_your_stripe_public_key"
PAYMENT_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
PAYMENT_CURRENCY="PEN"

# 7. URLs Públicas del Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
